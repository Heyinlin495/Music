# ============================================================
# Environment Variables
# Copy this file to .env and edit as needed
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=musicdb
DB_USERNAME=music
DB_PASSWORD=root123456
DB_USE_SSL=false

# JWT (MUST change in production, at least 256-bit random key)
JWT_SECRET=DevOnlySecretKeyThatIsAtLeast256BitsLongForJWTTokenGeneration12345678

# File upload paths
MUSIC_UPLOAD_PATH=./uploads/music
COVER_UPLOAD_PATH=./uploads/covers
AVATAR_UPLOAD_PATH=./uploads/avatars

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Storage: local | minio | oss
STORAGE_TYPE=local

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Alibaba Cloud OSS (uncomment if needed)
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET_NAME=music-files
# OSS_CDN_DOMAIN=

# Docker compose port mapping
BACKEND_PORT=8080
FRONTEND_PORT=5173
ADMIN_PORT=5174
