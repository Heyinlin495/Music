# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=musicdb
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_USE_SSL=false

# JWT配置 (请使用至少256位的随机密钥)
JWT_SECRET=generate_a_secure_random_key_at_least_256_bits_long_here

# 文件上传路径
MUSIC_UPLOAD_PATH=./uploads/music
COVER_UPLOAD_PATH=./uploads/covers

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# 存储配置 (local, minio, oss)
STORAGE_TYPE=local

# MinIO配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=music
MINIO_SECURE=false

# 阿里云OSS配置
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET_NAME=music-files
# OSS_CDN_DOMAIN=
